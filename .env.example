# MongoDB Connection String (Required for Vercel Cloud Deployment)
# Get your free cloud MongoDB cluster connection string at: https://www.mongodb.com/cloud/atlas
# NOTE: Never put your real password here! Put your real credentials in .env (which is ignored by git)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smarter_scheduler?retryWrites=true&w=majority

# Local Development Port (Optional, defaults to 3000)
PORT=3000
